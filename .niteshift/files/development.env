# Sandbox-local development values. Never connect this setup to a shared database.
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
DJANGO_SETTINGS_MODULE=niteshift_settings
DATABASE_URL=postgresql://plane:plane@plane-db:5432/plane
REDIS_URL=redis://plane-redis:6379/
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
SECRET_KEY=niteshift-plane-local-development-5e549283c7f94e1b
LIVE_SERVER_SECRET_KEY=niteshift-plane-live-development
AWS_REGION=us-east-1
USE_MINIO=1
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_PATH=/spaces
LIVE_BASE_URL=http://host.docker.internal:3100
LIVE_BASE_PATH=/live
IS_TEST=1
SKIP_ENV_VAR=1
AWS_S3_BUCKET_NAME=uploads
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
