# MinIO removed its public images. Build the pinned community release from source.
# https://github.com/minio/minio#source-only-distribution
FROM golang:1.24.9-alpine AS build
RUN apk add --no-cache git
RUN CGO_ENABLED=0 go install github.com/minio/minio@RELEASE.2025-10-15T17-29-55Z

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /go/bin/minio /usr/local/bin/minio
ENTRYPOINT ["minio"]
CMD ["server", "/export", "--console-address", ":9090"]
