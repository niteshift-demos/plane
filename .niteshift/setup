#!/usr/bin/env bash
# Plane development environment.
#   plane-backend  Django API, workers and infra containers (docker-compose-local.yml)
#   plane-apps     web / admin / space / live dev servers under turbo
#   plane-proxy    Caddy, fronts all of them on a single origin (the preview port)
set -euo pipefail

cd "$(dirname "$0")/.."

# Everything the browser touches goes through the proxy, so the whole stack shares one origin.
BASE_URL="${NITESHIFT_PORT_4000_URL:-http://localhost:4000}"
# MinIO signs upload URLs with the scheme of the incoming request; the preview is HTTPS.
case "$BASE_URL" in
  https://*) MINIO_ENDPOINT_SSL=1 ;;
  *) MINIO_ENDPOINT_SSL=0 ;;
esac

# Dev-only secrets: their scope dies with this sandbox. Kept fixed so reruns and
# resumes do not invalidate existing sessions or live-server tokens.
SECRET_KEY="niteshift-plane-local-development-secret-key"
LIVE_SERVER_SECRET_KEY="niteshift-plane-local-development-live-key"

# docker-compose-local.yml interpolates the root .env for the infra containers.
cp .env.example .env

# apps/api/.env is read by compose (env_file) for api, workers and the migrator.
# Drop the keys we override, then append the Niteshift values.
API_OVERRIDES='SECRET_KEY|CORS_ALLOWED_ORIGINS|WEB_URL|APP_BASE_URL|APP_BASE_PATH'
API_OVERRIDES="$API_OVERRIDES|ADMIN_BASE_URL|ADMIN_BASE_PATH|SPACE_BASE_URL|SPACE_BASE_PATH"
API_OVERRIDES="$API_OVERRIDES|LIVE_BASE_URL|LIVE_BASE_PATH|LIVE_SERVER_SECRET_KEY"
API_OVERRIDES="$API_OVERRIDES|USE_MINIO|MINIO_ENDPOINT_SSL|AWS_S3_ENDPOINT_URL"
# Django trusts these for CSRF as well, so the browser-facing origin has to be listed.
CORS_ALLOWED_ORIGINS="http://localhost:4000,http://localhost:3000,http://localhost:3001,http://localhost:3002"
[ "$BASE_URL" = "http://localhost:4000" ] || CORS_ALLOWED_ORIGINS="$BASE_URL,$CORS_ALLOWED_ORIGINS"

grep -vE "^(${API_OVERRIDES})=" apps/api/.env.example > apps/api/.env
cat >> apps/api/.env <<EOF
SECRET_KEY="$SECRET_KEY"
CORS_ALLOWED_ORIGINS="$CORS_ALLOWED_ORIGINS"
WEB_URL="$BASE_URL"
APP_BASE_URL="$BASE_URL"
APP_BASE_PATH=""
ADMIN_BASE_URL="$BASE_URL"
ADMIN_BASE_PATH="/god-mode"
SPACE_BASE_URL="$BASE_URL"
SPACE_BASE_PATH="/spaces"
LIVE_BASE_URL="$BASE_URL"
LIVE_BASE_PATH="/live"
LIVE_SERVER_SECRET_KEY="$LIVE_SERVER_SECRET_KEY"
USE_MINIO=1
MINIO_ENDPOINT_SSL=$MINIO_ENDPOINT_SSL
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
EOF

# The proxy is part of the sandbox image; install it if a future image drops it.
command -v caddy >/dev/null || { apt-get update && apt-get install -y caddy; }

corepack enable pnpm
pnpm install --frozen-lockfile

# turbo's dev task depends on ^build; build the shared packages once here so the
# dev servers start without rebuilding them.
pnpm turbo run build --filter='./packages/*'

docker compose -f docker-compose-local.yml build

# The live server needs Redis at startup, so bring the backend up before the
# app services start. A 200 from the API means db, migrations and Redis are ready.
ns services start plane-backend
curl -sf --retry 90 --retry-all-errors --retry-delay 5 -o /dev/null http://localhost:8000/api/instances/
